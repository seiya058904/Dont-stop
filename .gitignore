# The public workspace repository contains three frozen originals and the iteration source.
/archive/
/.codebase-memory/
/.workbuddy/

# Keep each child repository's local Git metadata out of the outer repository.
**/.git/

# Generated Godot editor/import state is local machine output, not source.
**/.godot/
**/.import/

# Common operating-system noise.
**/Thumbs.db
**/.DS_Store

# Iteration generated output and local evidence.
# gitignore patterns are literal: the apostrophe and the space in the project
# directory name are part of the path, and quoting it would match a directory
# whose name really contains quote characters.
/Don't stop/*.log
/Don't stop/build/
/Don't stop/evidence/
/Don't stop/output/

# Regenerated historical run output stays local; formal reports, manifests,
# matrices, and canonical evidence remain tracked.
/Don't stop/docs/iteration/evidence/**/*.log
/Don't stop/docs/iteration/evidence/m6/**/*.txt
/Don't stop/docs/iteration/evidence/m7/**/*.txt
/Don't stop/docs/iteration/evidence/m8/**/*.txt
/Don't stop/docs/iteration/evidence/m9/**/*.txt
/Don't stop/docs/iteration/evidence/m10/**/*.txt
/Don't stop/docs/iteration/evidence/m11/**/*.txt
/Don't stop/docs/iteration/evidence/presentation/test-logs.zip

