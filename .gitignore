# The public workspace repository contains three frozen originals and the iteration source.
/archive/

# Keep each child repository's local Git metadata out of the outer repository.
**/.git/

# Generated Godot editor/import state is local machine output, not source.
**/.godot/
**/.import/

# Common operating-system noise.
**/Thumbs.db
**/.DS_Store

# Iteration generated output and local evidence.
/TowDownGame-Iteration/*.log
/TowDownGame-Iteration/build/
/TowDownGame-Iteration/evidence/
