[sub_resource type="GDScript" id="GDScript_ni5ow"]
script/source = "extends BaseReward

var fire
var buff_active = false

func onRewardStart():
	fire = preload(\"res://game/other/FireEffect.tscn\").instantiate()
	add_child(fire)
	fire.hide()
var kill_count = 0

func onKill(monster:BaseMonster):
	kill_count += 1
	if kill_count == 3:
		doBuff()

func _on_timer_timeout():
	kill_count = 0

func doBuff():
	if $Buff.is_stopped():
		fire.show()
		buff_active = true
		PlayerData.player_fire_rate += 0.2
		$Buff.start(count + 1)

func _on_buff_timeout():
	if buff_active:
		buff_active = false
		PlayerData.player_fire_rate -= 0.2
	if is_instance_valid(fire): fire.hide()

func onRewardRemove():
	_on_buff_timeout()

func saved_state() -> Dictionary:
	return {\"kills\":kill_count,\"remaining\":$Buff.time_left,\"window\":$Timer.time_left}
func restore_state(state: Dictionary):
	kill_count = int(state.get(\"kills\",0))
	var remaining = float(state.get(\"remaining\",0))
	if remaining>0:
		buff_active = true; PlayerData.player_fire_rate += 0.2; fire.show(); $Buff.start(remaining)
	if state.get(\"window\",0)>0: $Timer.start(state.window)
"

